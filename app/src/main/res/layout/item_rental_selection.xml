<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Rental.Card.Interactive"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/list_padding"
    android:layout_marginEnd="@dimen/list_padding"
    android:layout_marginTop="@dimen/space_1"
    android:layout_marginBottom="@dimen/space_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image_phone"
                style="@style/Widget.Rental.Image"
                android:layout_width="@dimen/phone_thumbnail_size"
                android:layout_height="@dimen/phone_thumbnail_size"
                android:contentDescription="@string/phone_image" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/text_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
                <TextView
                    android:id="@+id/text_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
            </LinearLayout>
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_selected"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="@string/select_phone" />
        </LinearLayout>

        <com.google.android.material.chip.Chip
            android:id="@+id/text_status"
            style="@style/Widget.Rental.StatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1" />

        <LinearLayout
            android:id="@+id/layout_quantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quantity_label"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_minus"
                style="@style/Widget.Rental.Button.Icon"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:text="@string/minus_symbol" />
            <TextView
                android:id="@+id/text_quantity"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_plus"
                style="@style/Widget.Rental.Button.Icon"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:text="@string/plus_symbol" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
