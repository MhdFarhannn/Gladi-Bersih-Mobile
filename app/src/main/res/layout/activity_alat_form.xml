<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Rental.Screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Rental.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            style="@style/Widget.Rental.Scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                style="@style/Widget.Rental.Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/model_form_description"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:accessibilityHeading="true"
                    android:text="@string/phone_photo_optional"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_image_picker"
                    style="@style/Widget.Rental.Card.Interactive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/choose_gallery_image">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/image_preview"
                        style="@style/Widget.Rental.Image"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/image_preview_height"
                        android:layout_margin="@dimen/space_1"
                        android:contentDescription="@string/phone_image"
                        android:src="@drawable/ic_phone_placeholder" />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_pick_image"
                    style="@style/Widget.Rental.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/choose_gallery_image"
                    app:icon="@drawable/ic_gallery" />
                <TextView
                    android:id="@+id/text_image_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/gallery_image_helper"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
                <TextView
                    android:id="@+id/text_image_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_image"
                    style="@style/Widget.Rental.Progress.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="@string/gallery_image_processing"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Rental.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_3">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/model_information"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_category"
                            style="@style/Widget.Rental.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:hint="@string/category_search_hint"
                            app:startIconDrawable="@drawable/ic_category">
                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/input_category"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:completionThreshold="0"
                                android:inputType="text" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_name"
                            style="@style/Widget.Rental.TextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:hint="@string/phone_model_name"
                            app:startIconDrawable="@drawable/ic_phone">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="text" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Rental.TextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:hint="@string/specification_optional">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_description"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapSentences|textMultiLine"
                                android:minLines="3" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_price"
                            style="@style/Widget.Rental.TextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:hint="@string/daily_rental_price"
                            app:prefixText="@string/rupiah_prefix">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_price"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_save"
                        style="@style/Widget.Rental.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/save" />
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progress_save"
                        style="@style/Widget.Rental.Progress.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_1"
                        android:contentDescription="@string/saving"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:id="@+id/progress"
            style="@style/Widget.Rental.State"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <com.google.android.material.progressindicator.CircularProgressIndicator
                style="@style/Widget.Rental.Progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:accessibilityLiveRegion="polite"
                android:text="@string/loading_data"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layout_error"
            style="@style/Widget.Rental.State"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <ImageView
                android:layout_width="@dimen/state_icon_size"
                android:layout_height="@dimen/state_icon_size"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_error" />
            <TextView
                android:id="@+id/text_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_retry"
                style="@style/Widget.Rental.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="@string/retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
